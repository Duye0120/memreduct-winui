<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:MemReduct.Fluent" x:Class="MemReduct.Fluent.MainWindow" Title="Mem Reduct Fluent">
    <Grid x:Name="Shell" Background="{ThemeResource CanvasBrush}">
        <Grid.Resources>
            <Style x:Key="OverviewBody" TargetType="TextBlock" BasedOn="{StaticResource Body}"><Setter Property="FontSize" Value="14" /><Setter Property="Foreground" Value="{ThemeResource InkBrush}" /><Setter Property="LineHeight" Value="20" /></Style>
            <Style x:Key="OverviewMuted" TargetType="TextBlock" BasedOn="{StaticResource OverviewBody}"><Setter Property="Foreground" Value="{ThemeResource MutedBrush}" /></Style>
            <Style x:Key="OverviewHeading" TargetType="TextBlock" BasedOn="{StaticResource OverviewBody}"><Setter Property="FontSize" Value="18" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="LineHeight" Value="24" /></Style>
            <Style x:Key="OverviewValue" TargetType="TextBlock" BasedOn="{StaticResource OverviewHeading}"><Setter Property="FontWeight" Value="Medium" /></Style>
            <Style x:Key="OverviewReading" TargetType="TextBlock" BasedOn="{StaticResource OverviewBody}"><Setter Property="FontSize" Value="48" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="LineHeight" Value="56" /><Setter Property="TextWrapping" Value="NoWrap" /></Style>
            <Thickness x:Key="ExpanderHeaderBorderThickness">0</Thickness>
            <x:Double x:Key="ExpanderMinHeight">44</x:Double>
            <Thickness x:Key="ExpanderContentPadding">0,8,0,12</Thickness>
            <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent" />
            <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="Transparent" />
            <Style x:Key="OverviewExpander" TargetType="Expander"><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="CornerRadius" Value="0" /><Setter Property="MinHeight" Value="44" /><Setter Property="Padding" Value="0,0,0,8" /></Style>
            <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="{ThemeResource NavigationSelectedColor}" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="{ThemeResource NavigationSelectedColor}" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="{ThemeResource NavigationHoverColor}" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="{ThemeResource NavigationHoverColor}" />
            <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="{ThemeResource NavigationTextColor}" />
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="{ThemeResource NavigationTextColor}" />
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="{ThemeResource NavigationTextColor}" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="{ThemeResource NavigationHoverColor}" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="{ThemeResource NavigationHoverColor}" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="{ThemeResource NavigationHoverColor}" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TitleBar x:Name="AppTitleBar" Height="32" Background="{ThemeResource CanvasBrush}" Foreground="{ThemeResource InkBrush}">
            <TitleBar.Resources>
                <x:Double x:Key="TitleBarCompactHeight">32</x:Double>
                <x:Double x:Key="TitleBarExpandedHeight">32</x:Double>
                <x:Double x:Key="TitleBarMinDragRegionWidth">0</x:Double>
            </TitleBar.Resources>
            <TitleBar.LeftHeader><StackPanel x:Name="BrandHeader" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Image Source="Assets/AppIcon.ico" Width="20" Height="20" />
                    <TextBlock x:Name="BrandName" Text="Mem Reduct" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource InkBrush}" VerticalAlignment="Center" />
                </StackPanel></TitleBar.LeftHeader>
        </TitleBar>
        <Grid x:Name="AppSurface" Grid.Row="1" Background="{ThemeResource CanvasBrush}">
        <Grid x:Name="ContentLayout">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ScrollViewer x:Name="NotificationScroll" MaxHeight="200" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <InfoBar x:Name="IssueBanner" IsOpen="False" Visibility="Collapsed" IsClosable="True" Severity="Warning" Margin="0,12,0,0" CornerRadius="{StaticResource CardCornerRadius}" />
                        <InfoBar x:Name="UpdateNotice" IsOpen="False" Visibility="Collapsed" IsClosable="True" Severity="Informational" Margin="0,12,0,0" CornerRadius="{StaticResource CardCornerRadius}">
                            <InfoBar.ActionButton>
                                <Button x:Uid="UpdateDetailsButton" Content="查看更新" Click="UpdateDetails_Click" CornerRadius="{StaticResource AppControlCornerRadius}" />
                            </InfoBar.ActionButton>
                        </InfoBar>
                        <InfoBar x:Uid="AdminBanner" x:Name="AdminBanner" Title="自动清理已暂停" Message="自动清理需要管理员权限。" IsOpen="False" Visibility="Collapsed" IsClosable="False" Severity="Informational" Margin="0,12,0,0" CornerRadius="{StaticResource CardCornerRadius}">
                            <InfoBar.ActionButton>
                                <Button x:Uid="ElevateButton" x:Name="ElevateButton" Content="以管理员运行" CornerRadius="{StaticResource AppControlCornerRadius}" Click="Elevate_Click" />
                            </InfoBar.ActionButton>
                        </InfoBar>
                    </StackPanel>
                </ScrollViewer>
            <Grid x:Name="NavigationGutter" Grid.Row="1" Margin="20,0,20,12">
                <Grid x:Name="HeaderBar" MaxWidth="920" HorizontalAlignment="Stretch" MinHeight="40" ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel x:Name="NavigationPanel" Orientation="Horizontal" Spacing="20">
                        <ToggleButton x:Uid="OverviewTab" x:Name="OverviewTab" Content="内存" IsChecked="True" Style="{StaticResource NavigationButton}" Click="OverviewTab_Click" AutomationProperties.Name="内存概览" />
                        <ToggleButton x:Uid="SettingsTab" x:Name="SettingsTab" Content="设置" Style="{StaticResource NavigationButton}" Click="SettingsTab_Click" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock x:Name="PressureText" Style="{StaticResource OverviewMuted}" Text="—" />
                        <StackPanel x:Name="MonitoringStatus" Visibility="Collapsed" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Ellipse x:Name="LiveIndicator" Fill="{ThemeResource AccentBrush}" Width="5" Height="5" VerticalAlignment="Center" />
                            <TextBlock x:Name="LiveLabel" Text="实时" Style="{StaticResource Muted}" x:Uid="LiveLabel" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
            <ScrollViewer x:Name="BodyScroll" HorizontalContentAlignment="Stretch" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="20,0,20,16" Grid.Row="2">
                <Grid HorizontalAlignment="Stretch">
                <!-- Keep the width cap inside the full-width scroll child so centering uses arranged bounds. -->
                <Grid x:Name="PageContent" MaxWidth="920" HorizontalAlignment="Stretch">
                    <StackPanel x:Name="OverviewPage" Spacing="0">
                        <Border x:Name="MetricsCard" Style="{StaticResource Card}" Padding="0">
                            <Grid x:Name="MetricsGrid">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="224" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <StackPanel x:Name="PhysicalCell" Padding="16">
                                    <TextBlock x:Uid="PhysicalUsageLabel" Style="{StaticResource OverviewMuted}" Text="物理内存使用率" FontWeight="SemiBold" />
                                    <TextBlock x:Name="PhysicalValue" Text="—" Style="{StaticResource OverviewReading}" Margin="0,4,0,12" />
                                    <ProgressBar x:Name="PhysicalBar" Maximum="100" Height="6" MinHeight="6" Background="{ThemeResource MeterTrackBrush}" Foreground="{ThemeResource UsageNormalBrush}" Margin="0,0,0,12">
                                        <ProgressBar.Template><ControlTemplate TargetType="ProgressBar">
                                            <Grid x:Name="LayoutRoot" Height="6"><Border Background="{TemplateBinding Background}" CornerRadius="3" /><Rectangle x:Name="DeterminateProgressBarIndicator" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Left" Height="6" RadiusX="3" RadiusY="3" /></Grid>
                                        </ControlTemplate></ProgressBar.Template>
                                    </ProgressBar>
                                    <Grid x:Name="FactsGrid" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <StackPanel x:Name="UsedFact" Orientation="Horizontal" Spacing="8"><TextBlock x:Uid="UsedLabel" Text="已用" Style="{StaticResource OverviewMuted}" VerticalAlignment="Center" /><TextBlock x:Name="PhysicalUsed" Text="—" Style="{StaticResource OverviewValue}" /></StackPanel>
                                        <StackPanel x:Name="FreeFact" Grid.Column="1" Orientation="Horizontal" Spacing="8"><TextBlock x:Uid="AvailableLabel" Text="可用" Style="{StaticResource OverviewMuted}" VerticalAlignment="Center" /><TextBlock x:Name="PhysicalFree" Text="—" Style="{StaticResource OverviewValue}" /></StackPanel>
                                        <StackPanel x:Name="TotalFact" Grid.Column="2" Orientation="Horizontal" Spacing="8"><TextBlock x:Uid="TotalLabel" Text="总量" Style="{StaticResource OverviewMuted}" VerticalAlignment="Center" /><TextBlock x:Name="PhysicalTotal" Text="—" Style="{StaticResource OverviewValue}" /></StackPanel>
                                    </Grid>
                                    <Grid x:Name="MetricsDetails" Margin="0,12,0,0" Padding="0,12,0,0" BorderBrush="{ThemeResource OutlineBrush}" BorderThickness="0,0.5,0,0" ColumnSpacing="20" RowSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Border x:Name="CommitCell">
                                        <ToolTipService.ToolTip><StackPanel Spacing="4"><TextBlock x:Name="CommitUsed" Text="—" /><TextBlock x:Name="CommitTotal" Text="—" /></StackPanel></ToolTipService.ToolTip>
                                        <StackPanel x:Name="CommitStack" Orientation="Horizontal" Spacing="8"><TextBlock x:Uid="CommitLabel" Text="已提交内存" Style="{StaticResource OverviewMuted}" /><TextBlock x:Name="CommitValue" Text="—" Style="{StaticResource OverviewBody}" FontWeight="Medium" /></StackPanel>
                                    </Border>
                                    <StackPanel x:Name="CacheCell" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <ToolTipService.ToolTip><TextBlock x:Name="CachePeak" Text="—" /></ToolTipService.ToolTip>
                                        <TextBlock x:Uid="CacheLabel" Text="系统文件缓存" Style="{StaticResource OverviewMuted}" /><TextBlock x:Name="CacheValue" Text="—" Style="{StaticResource OverviewBody}" FontWeight="Medium" />
                                    </StackPanel>
                                    </Grid>
                                </StackPanel>
                                <Border x:Name="CleanCard" Grid.Column="1" Background="{ThemeResource ActionWellBrush}" BorderBrush="{ThemeResource OutlineBrush}" BorderThickness="0.5,0,0,0" CornerRadius="0,10,10,0" Padding="16">
                                    <StackPanel Spacing="12" VerticalAlignment="Center">
                                            <Button x:Name="CleanButton" Content="清理内存" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="36" FontSize="14" FontWeight="SemiBold" Padding="16,8" BorderThickness="0" CornerRadius="6" Background="{ThemeResource CleanButtonBrush}" Foreground="{ThemeResource CleanOnAccentBrush}" Click="CleanButton_Click">
                                                <Button.Resources>
                                                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="CleanHoverBrush" />
                                                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="CleanPressedBrush" />
                                                    <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="CleanOnAccentBrush" />
                                                    <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="CleanOnAccentBrush" />
                                                </Button.Resources>
                                                <ToolTipService.ToolTip><StackPanel Spacing="8"><TextBlock x:Name="CleanDescription" Text="—" Style="{StaticResource OverviewMuted}" /><TextBlock x:Name="ResultText" Text="—" Style="{StaticResource OverviewMuted}" /></StackPanel></ToolTipService.ToolTip>
                                            </Button>
                                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                                            <TextBlock x:Uid="LastFreedLabel" Text="上次释放" Style="{StaticResource OverviewMuted}" TextAlignment="Center" />
                                            <TextBlock x:Name="LastCleanupValue" Text="—" Visibility="Collapsed" Style="{StaticResource OverviewBody}" FontWeight="SemiBold" TextAlignment="Center" />
                                            <TextBlock x:Name="LastCleanupTime" Text="尚未清理" Style="{StaticResource OverviewBody}" TextAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                        <Grid x:Name="AutoPlanGrid" ColumnSpacing="12" Padding="0,12" MinHeight="44">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="AutoStatusText" Text="—" Style="{StaticResource OverviewMuted}" />
                            <TextBlock x:Name="ProtectionStatusText" Grid.Column="1" Style="{StaticResource OverviewMuted}" />
                        </Grid>
                        <StackPanel Spacing="0" BorderBrush="{ThemeResource OutlineBrush}" BorderThickness="0,0.5,0,0">
                            <Border x:Name="CleanupHistoryCard" BorderBrush="{ThemeResource OutlineBrush}" BorderThickness="0,0,0,0.5">
                                <Expander x:Name="CleanupHistoryExpander" IsExpanded="False" Style="{StaticResource OverviewExpander}">
                                    <Expander.Resources>
                                        <Thickness x:Key="ExpanderContentDownBorderThickness">0</Thickness>
                                        <Thickness x:Key="ExpanderContentUpBorderThickness">0</Thickness>
                                        <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="Transparent" />
                                        <SolidColorBrush x:Key="ExpanderContentBackground" Color="Transparent" />
                                    </Expander.Resources>
                                    <Expander.Header><Grid ColumnSpacing="24" Margin="-16,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Uid="CleanupHistoryHeading" Text="最近清理" Style="{StaticResource OverviewBody}" /><TextBlock x:Uid="SessionLabel" Grid.Column="1" Text="本次运行" Style="{StaticResource OverviewMuted}" /></Grid></Expander.Header>
                                    <StackPanel>
                                        <TextBlock x:Name="CleanupHistoryEmpty" x:Uid="CleanupHistoryEmpty" Text="本次运行暂无记录" Style="{StaticResource OverviewMuted}" />
                                        <ItemsControl ItemsSource="{x:Bind _cleanupHistory}">
                                            <ItemsControl.ItemTemplate><DataTemplate x:DataType="local:CleanupHistoryEntry">
                                                <Grid Padding="0,12" RowSpacing="4" BorderBrush="{ThemeResource OutlineBrush}" BorderThickness="0,0,0,0.5">
                                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                    <TextBlock Text="{x:Bind Outcome}" Style="{StaticResource OverviewBody}" /><TextBlock Grid.Column="1" Text="{x:Bind TimeLabel}" Style="{StaticResource OverviewMuted}" VerticalAlignment="Center" /><TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{x:Bind Details}" Style="{StaticResource OverviewMuted}" />
                                                </Grid>
                                            </DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Expander>
                            </Border>
                            <Border BorderBrush="{ThemeResource OutlineBrush}" BorderThickness="0,0,0,0.5">
                                <Expander x:Name="ProcessesExpander" Style="{StaticResource OverviewExpander}" Expanding="Processes_Expanding">
                                    <Expander.Resources>
                                        <Thickness x:Key="ExpanderContentDownBorderThickness">0</Thickness>
                                        <Thickness x:Key="ExpanderContentUpBorderThickness">0</Thickness>
                                        <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="Transparent" />
                                        <SolidColorBrush x:Key="ExpanderContentBackground" Color="Transparent" />
                                    </Expander.Resources>
                                    <Expander.Header><Grid ColumnSpacing="24" Margin="-16,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Uid="ProcessesHeading" Text="进程占用" Style="{StaticResource OverviewBody}" /><TextBlock x:Uid="DetailsLabel" Grid.Column="1" Text="查看详情" Style="{StaticResource OverviewMuted}" /></Grid></Expander.Header>
                                    <StackPanel Spacing="12">
                                        <TextBlock x:Uid="ProcessesDescription" Text="按工作集显示前 8 个进程，含共享内存，不能相加当作总用量。仅在展开或点击刷新时读取。" Style="{StaticResource OverviewMuted}" />
                                        <ItemsControl ItemsSource="{x:Bind _processRows}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="local:ProcessMemoryEntry">
                                            <Grid Padding="0,12" BorderBrush="{ThemeResource OutlineBrush}" BorderThickness="0,0,0,0.5" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Spacing="4"><TextBlock Text="{x:Bind Name}" Style="{StaticResource OverviewBody}" /><TextBlock Text="{x:Bind IdText}" Style="{StaticResource OverviewMuted}" /></StackPanel><TextBlock Grid.Column="1" Text="{x:Bind MemoryText}" Style="{StaticResource OverviewBody}" VerticalAlignment="Center" /></Grid>
                                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                        <Button x:Name="ProcessRefreshButton" x:Uid="ProcessRefreshButton" Content="刷新进程" Click="RefreshProcesses_Click" />
                                        <TextBlock x:Name="ProcessStatus" x:Uid="ProcessStatus" Text="展开后读取，不在后台扫描进程。" Style="{StaticResource OverviewMuted}" AutomationProperties.LiveSetting="Polite" />
                                    </StackPanel>
                                </Expander>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    <ContentControl x:Name="SettingsHost" Visibility="Collapsed" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top" />
                </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>
        </Grid>
    </Grid>
</Window>
